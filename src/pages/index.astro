---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero fade-in">
				<p class="greeting">Hi, I'm</p>
				<h1>Mohit Choudhary</h1>
				<p class="tagline">
					First-year <strong>BTech CSE</strong> student passionate about building things for the web
				</p>
				<p class="bio">
					I'm interested in <strong>web & app development</strong> and <strong>entrepreneurship</strong>.
					Currently exploring modern frameworks, learning to ship products, and writing about the journey along the way.
				</p>
				<div class="cta-group fade-in fade-in-delay-2">
					<a href={`${import.meta.env.BASE_URL}blog/`} class="btn btn-primary">Read the Blog</a>
					<a href={`${import.meta.env.BASE_URL}resume/`} class="btn btn-secondary">View Resume</a>
				</div>
				<div class="social-row fade-in fade-in-delay-3">
					<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="social-link">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
						</svg>
						GitHub
					</a>
					<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="social-link">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
						LinkedIn
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 4rem 0 2rem;
	}

	.greeting {
		font-size: 1rem;
		color: var(--text-tertiary);
		margin-bottom: 0.25rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	h1 {
		font-size: 3rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 1.25rem;
		color: var(--text-primary);
	}

	.tagline {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 0.75rem;
		max-width: 540px;
	}

	.tagline strong,
	.bio strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	.bio {
		font-size: 1rem;
		color: var(--text-tertiary);
		line-height: 1.7;
		margin-bottom: 2rem;
		max-width: 540px;
	}

	.cta-group {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 2.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.65rem 1.5rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		transition: all var(--transition);
	}

	.btn-primary {
		background-color: var(--text-primary);
		color: var(--bg-primary);
	}

	.btn-primary:hover {
		opacity: 0.85;
		transform: translateY(-1px);
	}

	.btn-secondary {
		background-color: transparent;
		color: var(--text-primary);
		border: 1px solid var(--border);
	}

	.btn-secondary:hover {
		background-color: var(--bg-secondary);
		border-color: var(--text-tertiary);
		transform: translateY(-1px);
	}

	.social-row {
		display: flex;
		gap: 1.25rem;
	}

	.social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-tertiary);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: color var(--transition);
	}

	.social-link:hover {
		color: var(--text-primary);
	}

	@media (max-width: 640px) {
		.hero {
			padding: 2rem 0 1rem;
		}
		h1 {
			font-size: 2.25rem;
		}
		.tagline {
			font-size: 1.05rem;
		}
		.cta-group {
			flex-direction: column;
			width: 100%;
		}
		.btn {
			justify-content: center;
		}
	}
</style>
