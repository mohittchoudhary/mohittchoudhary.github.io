---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Resume — ${SITE_TITLE}`} description="Mohit Choudhary's resume — BTech CSE student, web/app developer." />
	</head>
	<body>
		<Header />
		<main>
			<section class="resume-header fade-in">
				<h1>Resume</h1>
				<p class="resume-description">View or download my resume below.</p>
				<a href={`${import.meta.env.BASE_URL}resume.pdf`} download class="download-btn">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
						<polyline points="7 10 12 15 17 10"></polyline>
						<line x1="12" y1="15" x2="12" y2="3"></line>
					</svg>
					Download PDF
				</a>
			</section>
			<section class="resume-viewer fade-in fade-in-delay-1">
				<div class="pdf-container">
					<iframe
						src={`${import.meta.env.BASE_URL}resume.pdf`}
						title="Mohit Choudhary Resume"
						width="100%"
						height="100%"
					></iframe>
					<div class="pdf-fallback">
						<p>Unable to display the PDF?</p>
						<a href={`${import.meta.env.BASE_URL}resume.pdf`} target="_blank" rel="noopener noreferrer">
							Open in a new tab &rarr;
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.resume-header {
		padding: 2rem 0 1.5rem;
	}

	.resume-header h1 {
		margin-bottom: 0.5rem;
	}

	.resume-description {
		color: var(--text-tertiary);
		margin-bottom: 1.25rem;
	}

	.download-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 1.25rem;
		background-color: var(--text-primary);
		color: var(--bg-primary);
		border-radius: 8px;
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: all var(--transition);
	}

	.download-btn:hover {
		opacity: 0.85;
		transform: translateY(-1px);
		color: var(--bg-primary);
	}

	.resume-viewer {
		margin-top: 0.5rem;
	}

	.pdf-container {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		background-color: var(--bg-secondary);
	}

	.pdf-container iframe {
		display: block;
		border: none;
		min-height: 80vh;
	}

	.pdf-fallback {
		padding: 1.5rem;
		text-align: center;
		border-top: 1px solid var(--border);
	}

	.pdf-fallback p {
		color: var(--text-tertiary);
		font-size: 0.875rem;
		margin-bottom: 0.5rem;
	}

	.pdf-fallback a {
		color: var(--text-secondary);
		font-size: 0.875rem;
	}

	.pdf-fallback a:hover {
		color: var(--text-primary);
	}
</style>
