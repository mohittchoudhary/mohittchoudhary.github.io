---
---

<button id="search-btn" aria-label="Search" title="Search (Ctrl+K)">
	<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="11" cy="11" r="8"></circle>
		<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
	</svg>
	<span class="search-label">Search</span>
	<kbd class="search-kbd">⌘K</kbd>
</button>

<!-- Search modal overlay -->
<div id="search-overlay" class="search-overlay" aria-hidden="true">
	<div class="search-modal">
		<div id="search-container"></div>
		<button id="search-close" class="search-close" aria-label="Close search">&times;</button>
	</div>
</div>

<style>
	#search-btn {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		background: none;
		border: 1px solid var(--border);
		border-radius: 8px;
		cursor: pointer;
		padding: 6px 10px;
		color: var(--text-tertiary);
		font-size: 0.8rem;
		font-family: inherit;
		transition: color var(--transition), border-color var(--transition), background-color var(--transition);
	}

	#search-btn:hover {
		color: var(--text-primary);
		border-color: var(--text-tertiary);
		background-color: var(--bg-secondary);
	}

	.search-label {
		display: none;
	}

	.search-kbd {
		display: none;
		font-family: inherit;
		font-size: 0.7rem;
		padding: 1px 5px;
		border-radius: 4px;
		background-color: var(--bg-tertiary);
		color: var(--text-tertiary);
		border: none;
	}

	@media (min-width: 640px) {
		.search-label,
		.search-kbd {
			display: inline;
		}
	}

	.search-overlay {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 200;
		background-color: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		justify-content: center;
		align-items: flex-start;
		padding-top: 10vh;
	}

	.search-overlay.active {
		display: flex;
	}

	.search-modal {
		width: 90%;
		max-width: 600px;
		background-color: var(--bg-primary);
		border-radius: 12px;
		border: 1px solid var(--border);
		box-shadow: 0 16px 48px rgba(0, 0, 0, 0.15);
		position: relative;
		overflow: hidden;
		max-height: 70vh;
		display: flex;
		flex-direction: column;
	}

	.search-close {
		position: absolute;
		top: 0.5rem;
		right: 0.75rem;
		background: none;
		border: none;
		cursor: pointer;
		color: var(--text-tertiary);
		font-size: 1.5rem;
		line-height: 1;
		padding: 4px;
		transition: color var(--transition);
		z-index: 10;
	}

	.search-close:hover {
		color: var(--text-primary);
	}

	/* Pagefind UI theme overrides */
	#search-container {
		overflow-y: auto;
	}

	:global(.pagefind-ui) {
		--pagefind-ui-scale: 0.9;
		--pagefind-ui-primary: var(--text-primary);
		--pagefind-ui-text: var(--text-secondary);
		--pagefind-ui-background: var(--bg-primary);
		--pagefind-ui-border: var(--border);
		--pagefind-ui-tag: var(--bg-tertiary);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 8px;
		--pagefind-ui-image-border-radius: 8px;
		--pagefind-ui-image-box-ratio: 0;
		--pagefind-ui-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	:global(.pagefind-ui .pagefind-ui__search-input) {
		font-weight: 500;
		background-color: var(--bg-primary) !important;
		color: var(--text-primary) !important;
	}

	:global(.pagefind-ui .pagefind-ui__result-link) {
		color: var(--text-primary) !important;
	}

	:global(.pagefind-ui .pagefind-ui__result-excerpt) {
		color: var(--text-secondary) !important;
	}

	:global(.pagefind-ui .pagefind-ui__button) {
		background-color: var(--bg-secondary) !important;
		color: var(--text-primary) !important;
		border: 1px solid var(--border) !important;
	}

	:global(.pagefind-ui .pagefind-ui__message) {
		color: var(--text-tertiary) !important;
	}
</style>

<script>
	let pagefindLoaded = false;

	async function loadPagefind() {
		if (pagefindLoaded) return;
		try {
			// Dynamically determine the base URL for pagefind assets
			const base = import.meta.env.BASE_URL || '/';
			const pagefindPath = `${base}pagefind/pagefind-ui.js`;
			const cssPath = `${base}pagefind/pagefind-ui.css`;

			// Load CSS
			const link = document.createElement('link');
			link.rel = 'stylesheet';
			link.href = cssPath;
			document.head.appendChild(link);

			// Load JS
			const script = document.createElement('script');
			script.src = pagefindPath;
			document.head.appendChild(script);

			await new Promise<void>((resolve, reject) => {
				script.onload = () => resolve();
				script.onerror = () => reject(new Error('Failed to load Pagefind'));
			});

			// @ts-ignore - PagefindUI is loaded from external script
			new window.PagefindUI({
				element: '#search-container',
				showSubResults: true,
				showImages: false,
				baseUrl: base,
			});

			pagefindLoaded = true;

			// Auto-focus the search input
			setTimeout(() => {
				const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
				if (input) input.focus();
			}, 100);
		} catch (e) {
			console.warn('Pagefind not available — run `npm run build` first to generate search index.');
			const container = document.getElementById('search-container');
			if (container) {
				container.innerHTML = '<p style="padding:2rem;color:var(--text-tertiary);text-align:center;font-size:0.9rem;">Search is only available in production builds.<br>Run <code>npm run build</code> then <code>npm run preview</code> to test.</p>';
			}
		}
	}

	function openSearch() {
		const overlay = document.getElementById('search-overlay');
		if (!overlay) return;
		overlay.classList.add('active');
		overlay.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
		loadPagefind();
	}

	function closeSearch() {
		const overlay = document.getElementById('search-overlay');
		if (!overlay) return;
		overlay.classList.remove('active');
		overlay.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	}

	function initSearch() {
		const btn = document.getElementById('search-btn');
		const overlay = document.getElementById('search-overlay');
		const close = document.getElementById('search-close');

		if (btn) btn.addEventListener('click', openSearch);
		if (close) close.addEventListener('click', closeSearch);

		// Close on backdrop click
		if (overlay) {
			overlay.addEventListener('click', (e) => {
				if (e.target === overlay) closeSearch();
			});
		}

		// Keyboard shortcuts
		document.addEventListener('keydown', (e) => {
			// Ctrl/Cmd + K to open
			if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
				e.preventDefault();
				openSearch();
			}
			// Escape to close
			if (e.key === 'Escape') {
				closeSearch();
			}
		});
	}

	initSearch();
	document.addEventListener('astro:after-swap', () => {
		pagefindLoaded = false;
		initSearch();
	});
</script>
